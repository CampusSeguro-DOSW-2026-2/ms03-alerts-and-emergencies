{
  "info": {
    "name": "MS03 Alertas y Emergencias",
    "description": "Contrato real de MS03 (rama develop). Requiere el backend con perfil local: los tokens salen de GET /local/tokens.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "00 Tokens locales",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "['COORDINATOR','AUDITOR','SERVICE_MS06','USER'].forEach(r => pm.collectionVariables.set('token' + r, j[r]));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/local/tokens"
      }
    },
    {
      "name": "01 Ciclo de vida",
      "item": [
        {
          "name": "Crear y emitir (activateImmediately)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test('ACTIVE', () => pm.expect(j.status).to.eql('ACTIVE'));",
                  "pm.test('campos en inglés', () => ['title','instructions','scope','recipients','activatedAt'].forEach(k => pm.expect(j).to.have.property(k)));",
                  "pm.collectionVariables.set('activeId', j.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenCOORDINATOR}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/alertas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"OTHER\",\n  \"title\": \"Simulacro de evacuación\",\n  \"instructions\": \"Dirígete al punto de encuentro más cercano.\",\n  \"scope\": {\n    \"type\": \"BUILDING\",\n    \"ids\": [\n      \"BLD-001\"\n    ]\n  },\n  \"recipients\": [\n    {\n      \"type\": \"ROLE\",\n      \"id\": \"STUDENT\"\n    }\n  ],\n  \"activateImmediately\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
