# Los scripts se ejecutan en Linux aunque el repositorio se toque en Windows.
# Sin esto, git guarda CRLF y el runner falla con "set: pipefail: invalid option name".
*.sh text eol=lf

# YAML y workflows: LF para que los bloques `run: |` no lleguen con CR al runner.
*.yml text eol=lf
*.yaml text eol=lf

# Archivos de infraestructura: siempre LF.
infra/*.yml text eol=lf
infra/*.yaml text eol=lf
infra/Caddyfile text eol=lf
