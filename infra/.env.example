# Variables del despliegue de MS03.
#
# En el flujo normal NO se usa este archivo: el runner self-hosted las recibe del
# Environment de GitHub `ms03-test` o `ms03-prod` (ver la guía). Sirve para un
# despliegue manual en la VM o para documentar qué necesita el stack.

# Entorno: test (puerto 8443 del borde) o prod (puerto 443)
ENTORNO=test

# Imagen publicada por el CI (el sufijo -api lo pone ci.yml)
IMAGE=ghcr.io/campusseguro-dosw-2026-2/ms03-alerts-and-emergencies-api
TAG=sha-REEMPLAZAR

# Dónde deja deploy.sh los archivos del stack
DEPLOY_DIR=/home/ubuntu/campusseguro/ms03

# URL del Gateway del MISMO entorno (test con :8443, prod sin puerto)
GATEWAY_URL=https://campusseguro-gw.northcentralus.cloudapp.azure.com:8443

# Clave de servicio de MS03 para ese entorno: la MISMA que GW_SERVICE_KEY_MS03 en el Gateway.
# Generar con: openssl rand -base64 48
GATEWAY_SERVICE_KEY=REEMPLAZAR

# Base de datos del stack (una por entorno)
DB_PASSWORD=REEMPLAZAR

# Correo: `log` no envía nada (recomendado mientras no haya proveedor real)
MAIL_PROVIDER=log
MAIL_FROM=no-reply@campusseguro.local
MAIL_FROM_NAME=CampusSeguro
APP_BASE_URL=https://campusseguro-gw.northcentralus.cloudapp.azure.com
